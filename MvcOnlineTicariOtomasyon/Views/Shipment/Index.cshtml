@using MvcOnlineTicariOtomasyon.Models.Class;
@model List<Shipment>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<div style="margin-top:20px">
    @using (Html.BeginForm("Index", "Shipment", FormMethod.Get))
    {
        <div class="row">
            <div class="col-md-4">
                <label style="font-weight:bold;">Tracking Code:</label>
                <div class="input-group">
                    <input type="text" name="p" class="form-control" placeholder="Enter tracking code..." value="@Request.QueryString["p"]" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<table class="table table-bordered" style="margin-top:20px">
    <tr>
        <th>HandleBy</th>
        <th>Recipient Name</th>
        <th>Tracking Code</th>
        <th>Date</th>
        <th>Detail</th>
    </tr>
    @foreach (var d in Model)
    {
        <tr>
            <td>
                @d.Staff
            </td>
            <td>
                @d.Customer
            </td>
            <td>
                @d.TrackingCode
            </td>
            <td>
                @d.Date
            </td>
            <td>
                <a href="/Shipment/CargoTracking/@d.TrackingCode" class="btn btn-info">
                    <i class="fas fa-eye"></i> Detail
                </a>
            </td>
        </tr>
    }
</table>

<a href="/Shipment/NewShipment" class="btn btn-info">Add New Shipment </a>