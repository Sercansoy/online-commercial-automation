@using MvcOnlineTicariOtomasyon.Models.Class
@model List<InvoiceItem>
@{
    ViewBag.Title = "DetailInvoice";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container-fluid">
    <br />
    <h2 class="mt-2">Invoice Item Details</h2>
    <hr />

    <div class="alert alert-info" style="border-left: 5px solid #0dcaf0;">
        <i class="fas fa-barcode"></i> <strong>Sequence Number:</strong> @ViewBag.InvoiceNum
    </div>

    @* Tablo Kartı *@
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Description</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-center">Unit Price</th>
                        <th class="text-center">Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td class="align-middle">@x.Description</td>
                            <td class="text-center align-middle"> @x.Quantity</td>
                            <td class="text-center align-middle"> @x.UnitPrice.ToString("C", new System.Globalization.CultureInfo("en-US"))</td>
                            <td class="text-center align-middle"> @x.TotalAmount.ToString("C", new System.Globalization.CultureInfo("en-US"))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <br />
    <a href="/Invoices/NewItem?invoiceId=@ViewBag.InvoiceId" class="btn btn-success">
        <i class="fas fa-plus-circle"></i> Add New Item
    </a>
                     