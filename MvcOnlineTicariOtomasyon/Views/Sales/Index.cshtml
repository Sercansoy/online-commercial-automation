@using MvcOnlineTicariOtomasyon.Models.Class
@model List<SaleTransaction>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<div class="container-fluid pt-4">
    <h2 class="mt-2 text-dark font-weight-normal mb-3">Sales Transactions</h2>

    <div class="table-responsive">
        <table id="tbl1" class="table table-bordered table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product</th>
                    <th>Customer</th>
                    <th>Staff</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th>Time</th>
                    <th>Update</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="font-weight-bold">@d.SaleID</td>
                        <td>@d.Product.ProductName</td>
                        <td>@d.Customer.CustomerName @d.Customer.CustomerSurname</td>
                        <td>@d.Staff.StaffName @d.Staff.StaffSurname</td>
                        <td>@d.Quantity</td>
                        <td>@d.Price.ToString("N2")</td>
                        <td class="font-weight-bold">@d.TotalAmount.ToString("N2")</td>
                        <td>@d.Date.ToString("dd.MM.yyyy HH:mm")</td>

                        <td>
                            <a href="/Sales/FindSale/@d.SaleID" class="btn btn-warning btn-sm text-white">
                                <i class="fas fa-edit"></i> Update
                            </a>
                        </td>

                        <td>
                            <a href="/Sales/SaleDetail/@d.SaleID" class="btn btn-info btn-sm text-white">
                                <i class="fas fa-eye"></i> Detail
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3 mb-4">
        <a href="/Sales/NewSale" class="btn btn-primary shadow-sm" style="background-color: dodgerblue; border: none;">
            <i class="fas fa-plus-circle mr-1"></i> New Sale
        </a>
    </div>
</div>

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<link href="~/Content/DataTables/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/DataTables/css/responsive.bootstrap.min.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="~/Scripts/DataTables/jquery.dataTables.min.js"></script>
<script src="~/Scripts/DataTables/dataTables.bootstrap.min.js"></script>

<script>
    $('#tbl1').dataTable({});
</script>