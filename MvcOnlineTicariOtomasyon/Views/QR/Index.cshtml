@{
    ViewBag.Title = "QR Code Generator";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .qr-container {
        max-width: 500px;
        margin: 40px auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        text-align: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .qr-title {
        font-size: 24px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 20px;
    }

    .qr-form-group {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 25px;
    }

    .qr-input {
        width: 100%;
        padding: 12px 15px;
        border: 1.5px solid #e0e0e0;
        border-radius: 8px;
        font-size: 15px;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

        .qr-input:focus {
            border-color: #3498db;
            outline: none;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.15);
        }

    .qr-btn {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.1s ease;
    }

        .qr-btn:hover {
            background-color: #2980b9;
        }

        .qr-btn:active {
            transform: scale(0.98);
        }

    .qr-result {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #f0f0f0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .qr-image {
        max-width: 100%;
        width: 250px;
        height: 250px;
        border-radius: 8px;
        border: 1px solid #eee;
        padding: 10px;
        background: #fff;
    }

    .qr-download-btn {
        margin-top: 15px;
        display: inline-block;
        color: #3498db;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

        .qr-download-btn:hover {
            text-decoration: underline;
        }
</style>

<div class="qr-container">
    <h2 class="qr-title">QR Code Generator</h2>

    @using (Html.BeginForm("Index", "QR", FormMethod.Post))
    {
        <div class="qr-form-group">
            <input type="text"
                   name="code"
                   class="qr-input"
                   placeholder="Enter text or URL here..."
                   required
                   autocomplete="off" />

            <button type="submit" class="qr-btn">
                Generate QR Code
            </button>
        </div>
    }

    @if (ViewBag.QrCodeImage != null)
    {
        <div class="qr-result">
            <img src="@Html.Raw(ViewBag.QrCodeImage)" alt="Generated QR Code" class="qr-image" />

            <a href="@Html.Raw(ViewBag.QrCodeImage)" download="qrcode.png" class="qr-download-btn">
                ↓ Download QR Code
            </a>
        </div>
    }
</div>