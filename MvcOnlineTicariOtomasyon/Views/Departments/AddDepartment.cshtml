@model MvcOnlineTicariOtomasyon.Models.Class.Department
@{
    ViewBag.Title = "AddDepartment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container-fluid mt-5">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h2 class="card-title mb-0 font-weight-bold">Add New Department</h2>
                </div>

                <div class="card-body text-center px-lg-5 py-5">
                    <p class="text-muted mb-4">Enter the details below to create a new category for your commercial automation system.</p>

                    <form method="post">
                        <div class="form-group mx-auto" style="max-width: 600px;">
                            @Html.LabelFor(x => x.DepartmentName, "Department Name", new { @class = "font-weight-bold h5 mb-3" })

                            @Html.TextBoxFor(x => x.DepartmentName, new { @class = "form-control text-center form-control-lg border-primary", placeholder = "e.g. Saler, Accountancy...", style = "border-width: 2px;" })

                            <small class="form-text text-muted mt-2">Use descriptive and clear names for departments.</small>
                        </div>

                        <div class="mt-5 d-flex justify-content-center">
                            <button class="btn btn-info btn-lg px-5 shadow-sm mr-3">
                                <i class="fas fa-plus-circle"></i> Add Department
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

