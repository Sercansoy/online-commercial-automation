@using MvcOnlineTicariOtomasyon.Models.Class
@model List<SaleTransaction>
@{
    ViewBag.Title = "SaleDetail";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container-fluid pt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mt-2 text-dark font-weight-normal mb-3">Sales Detail</h2>

            <div class="table-responsive">
                <table class="table table-bordered custom-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Customer</th>
                            <th>Staff</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Total</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td>@x.Product.ProductName</td>
                                <td>@x.Customer.CustomerName @x.Customer.CustomerSurname</td>
                                <td>@x.Staff.StaffName @x.Staff.StaffSurname</td>
                                <td>@x.Price.ToString("C", new System.Globalization.CultureInfo("en-US"))</td>
                                <td>@x.Quantity</td>
                                <td class="font-weight-bold">@x.TotalAmount.ToString("C", new System.Globalization.CultureInfo("en-US"))</td>
                                <td>@x.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button class="btn btn-default" style="background-color:dodgerblue">Print</button>
        </div>
    </div>
</div>

