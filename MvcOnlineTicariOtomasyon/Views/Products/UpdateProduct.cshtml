@model MvcOnlineTicariOtomasyon.Models.Class.Product
@{
    ViewBag.Title = "Update Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">

                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0 font-weight-bold">
                        <i class="fas fa-edit mr-2"></i> Update Product Details
                    </h3>
                </div>

                <div class="card-body p-5">
                    @using (Html.BeginForm("UpdateProduct", "Products", FormMethod.Post))
                    {
                        @Html.HiddenFor(x => x.ProductID)

                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark ml-1">Product Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0"><i class="fas fa-tag text-primary"></i></span>
                                </div>
                                @Html.TextBoxFor(x => x.ProductName, new { @class = "form-control custom-input border-left-0", placeholder = "e.g. Laptop..." })
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark ml-1">Brand</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0"><i class="fas fa-shield-alt text-primary"></i></span>
                                </div>
                                @Html.TextBoxFor(x => x.Brand, new { @class = "form-control custom-input border-left-0", placeholder = "e.g. Dell, Apple..." })
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark ml-1">Stock Quantity</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0"><i class="fas fa-layer-group text-primary"></i></span>
                                </div>
                                @Html.TextBoxFor(x => x.Stock, new { @class = "form-control custom-input border-left-0", type = "number" })
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark ml-1">Cost Price</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0"><i class="fas fa-dollar-sign text-primary"></i></span>
                                </div>
                                @Html.TextBoxFor(x => x.CostPrice, new { @class = "form-control custom-input border-left-0" })
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark ml-1">Selling Price</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0"><i class="fas fa-hand-holding-usd text-primary"></i></span>
                                </div>
                                @Html.TextBoxFor(x => x.SellingPrice, new { @class = "form-control custom-input border-left-0" })
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark ml-1">Category</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0"><i class="fas fa-folder text-primary"></i></span>
                                </div>
                                @Html.DropDownListFor(x => x.Categoryid, (List<SelectListItem>)ViewBag.CategoryList, new { @class = "form-control custom-input border-left-0" })
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark ml-1">Status</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0"><i class="fas fa-toggle-on text-primary"></i></span>
                                </div>
                                @Html.TextBoxFor(x => x.Status, new { @class = "form-control custom-input border-left-0" })
                            </div>
                        </div>

                        <div class="form-group mb-5">
                            <label class="font-weight-bold text-dark ml-1">Product Image URL</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0"><i class="fas fa-image text-primary"></i></span>
                                </div>
                                @Html.TextBoxFor(x => x.ProductImage, new { @class = "form-control custom-input border-left-0" })
                            </div>
                        </div>

                        <div class="d-flex flex-column align-items-center">
                            <button class="btn btn-success text-white py-3 shadow-sm hover-button mb-3" style="border-radius: 8px; font-weight: 600; width: 100%; max-width: 400px; border:none; background-color: #28a745;">
                                <i class="fas fa-sync-alt mr-2"></i> Update Product Information
                            </button>
                            <a href="/Products/Index" class="text-muted small font-weight-bold text-decoration-none">
                                <i class="fas fa-arrow-left mr-1"></i> Back to Product List
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>

    .custom-input {
        border: 1px solid #ced4da;
        border-radius: 0 8px 8px 0;
        padding: 10px 15px;
        height: auto;
        font-size: 0.95rem;
        transition: all 0.2s ease-in-out;
    }

    .input-group-text {
        border-radius: 8px 0 0 8px;
        border: 1px solid #ced4da;
    }

    .custom-input:focus {
        border-color: #007bff;
        box-shadow: none;
        background-color: #fff;
    }

    .form-group label {
        font-size: 0.9rem;
        margin-bottom: 7px;
    }

    .hover-button {
        transition: 0.3s;
    }

        .hover-button:hover {
            transform: translateY(-2px);
            opacity: 0.9;
        }

    body {
        background-color: #f0f2f5;
    }
</style>