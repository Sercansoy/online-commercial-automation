@model MvcOnlineTicariOtomasyon.Models.Class.Invoice
@{
    ViewBag.Title = "AddInvoice";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container-fluid pt-4 px-4">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-11 col-12">

            <div class="d-flex align-items-center justify-content-between mb-4">
                <h4 class="mb-0 text-dark font-weight-bold">Create New Invoice</h4>
                <a href="/Invoices/Index" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="fas fa-arrow-left fa-sm mr-1"></i> Back to Invoices
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-5">

                    @using (Html.BeginForm("AddInvoice", "Invoices", FormMethod.Post))
                    {
                        <div class="row">
                            <div class="col-md-6 form-group mb-4">
                                <label class="form-label text-muted font-weight-bold small">Invoice Serial Number</label>
                                @Html.TextBoxFor(x => x.InvoiceSerialNumber, new { @class = "form-control custom-form-input", placeholder = "e.g., A" })
                            </div>
                            <div class="col-md-6 form-group mb-4">
                                <label class="form-label text-muted font-weight-bold small">Invoice Sequence Number</label>
                                @Html.TextBoxFor(x => x.InvoiceSequenceNumber, new { @class = "form-control custom-form-input", placeholder = "e.g., 347654" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-4">
                                <label class="form-label text-muted font-weight-bold small">Date</label>
                                @Html.TextBoxFor(x => x.Date, new { @class = "form-control custom-form-input", type = "date" })
                            </div>
                            <div class="col-md-6 form-group mb-4">
                                <label class="form-label text-muted font-weight-bold small">Time</label>
                                @Html.TextBoxFor(x => x.Time, new { @class = "form-control custom-form-input", type = "time" })
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label text-muted font-weight-bold small">Tax Office</label>
                            @Html.TextBoxFor(x => x.TaxOffice, new { @class = "form-control custom-form-input", placeholder = "Enter tax office" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-4">
                                <label class="form-label text-muted font-weight-bold small">Delivered By</label>
                                @Html.TextBoxFor(x => x.DeliveredBy, new { @class = "form-control custom-form-input", placeholder = "Staff name" })
                            </div>
                            <div class="col-md-6 form-group mb-4">
                                <label class="form-label text-muted font-weight-bold small">Received By</label>
                                @Html.TextBoxFor(x => x.ReceivedBy, new { @class = "form-control custom-form-input", placeholder = "Customer/Staff name" })
                            </div>
                        </div>

                        <hr class="my-4 opacity-50">

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-5 py-2-5 font-weight-bold shadow-sm" style="font-size: 0.95rem; border-radius: 4px;">
                                <i class="fas fa-save mr-2"></i> Save New Invoice
                            </button>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .custom-form-input {
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 12px 16px;
        font-size: 0.95rem;
        height: auto;
        background-color: #fff;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .custom-form-input:focus {
            border-color: #80bdff;
            outline: 0;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            background-color: #fff;
        }

    .form-label {
        letter-spacing: 0.8px;
        margin-bottom: 8px;
        display: block;
    }

    .py-2-5 {
        padding-top: 10px;
        padding-bottom: 10px;
    }
</style>