@using MvcOnlineTicariOtomasyon.Models.Class;
@model  List<Department>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<table class="table table-bordered" style="margin-top:20px">
    <tr>
        <th>ID</th>
        <th>Department Name</th>
        <th>Update</th>
        <th>Delete</th>
        <th>Detail</th>
    </tr>
    @foreach (var d in Model)
    {
        <tr>
            <td>
                @d.DepartmentID
            </td>
            <td>
                @d.DepartmentName
            </td>
            <td>
                <a href="/Departments/FindDepartment/@d.DepartmentID" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Update
                </a>

            </td>
            <td>
                <a href="/Departments/RemoveDepartment/@d.DepartmentID" class="btn btn-danger">
                    <i class="fas fa-trash-alt"></i> Delete
                </a>
            </td>
            <td>
                <a href="/Departments/DetailDepartment/@d.DepartmentID" class="btn btn-info">
                    <i class="fas fa-eye" ></i> Detail
                </a>
            </td>
        </tr>
    }

</table>
<a href="/Departments/AddDepartment" class="btn btn-info">Add Department</a>

