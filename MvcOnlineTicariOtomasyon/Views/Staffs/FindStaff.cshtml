@model MvcOnlineTicariOtomasyon.Models.Class.Staff
@{
    ViewBag.Title = "FindStaff";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Update Staff Information</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("UpdateStaff", "Staffs", FormMethod.Post, new {enctype= "multipart/form-data" }))
            {
                @Html.HiddenFor(x => x.StaffID)

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(x => x.StaffName, "First Name")
                        @Html.TextBoxFor(x => x.StaffName, new { @class = "form-control", placeholder = "Enter name..." })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(x => x.StaffSurname, "Last Name")
                        @Html.TextBoxFor(x => x.StaffSurname, new { @class = "form-control", placeholder = "Enter surname..." })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="font-weight-bold">Staff Image (Option 1: Upload File)</label>
                        <input type="file" name="ImageFile" class="form-control" accept="image/*" />

                        <div class="text-center my-2 text-muted font-weight-bold small">- OR -</div>

                        <label class="font-weight-bold">Staff Image (Option 2: URL)</label>
                        @Html.TextBoxFor(x => x.StaffImage, new { @class = "form-control", placeholder = "Paste image URL path" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(x => x.Department, "Department")
                        @Html.DropDownListFor(x => x.Departmentid, (List<SelectListItem>)ViewBag.DepartmentList, "Select Department...", new { @class = "form-control custom-form-input form-select" })

                        @if (!string.IsNullOrEmpty(Model.StaffImage))
                        {
                            <div class="mt-3">
                                <label class="d-block text-muted small font-weight-bold">CURRENT IMAGE</label>
                                <img src="@Model.StaffImage" alt="Staff Image" class="img-thumbnail" style="max-height: 100px; object-fit: cover;" />
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a href="/Staffs/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            }
        </div>
    </div>
</div>

