@using MvcOnlineTicariOtomasyon.Models.Class
@model List<Staff>
@{
    ViewBag.Title = "Department Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container-fluid">
    <br />
    <h2 class="mt-2">Department Details</h2>
    <hr />

    <div class="alert alert-info" style="border-left: 5px solid #0dcaf0;">
        <i class="fas fa-building"></i> <strong>Selected Department:</strong> @ViewBag.DepartmentName
    </div>

    @* Tablo Kartı *@
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="card-title mb-0" style="font-size:16px;">Staff Members List</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Staff Full Name</th>
                        <th class="text-center">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td class="align-middle">@x.StaffName @x.StaffSurname</td>
                            <td class="text-center align-middle">
                                <a href="/Departments/StaffSales/@x.StaffID" class="btn btn-sm text-white" style="background-color: #ff4500; border-radius:15px; padding: 5px 15px;">
                                    <i class="fas fa-shopping-basket"></i> View Sales
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>