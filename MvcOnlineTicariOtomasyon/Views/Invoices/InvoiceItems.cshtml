@model MvcOnlineTicariOtomasyon.Models.Class.InvoiceTg

@{
    ViewBag.Title = "InvoiceItems";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />
<br />

<div class="card">

    <div class="card-header">

        <div class="d-flex justify-content-between align-items-center">

            <h2 class="card-title" style="margin:0;">
                <strong>Invoice Details</strong>
            </h2>

            <button class="btn btn-primary" onclick="addNewOrder()">New InvoiceItem</button>

        </div>

    </div>

    @foreach (var item in Model.Invoices)
    {
        <div class="card-body">
            <table class="table table-striped table-responsive">
                <tbody>
                    <tr>
                        <td>Seria-Sequence Number: @item.InvoiceSerialNumber-@item.InvoiceSequenceNumber </td>
                        <td>Date: @item.Date </td>
                        <td>Tax Office: @item.TaxOffice </td>
                    </tr>

                    <tr>
                        <td colspan="3">
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th>Description</th>
                                        <th>Quantity</th>
                                        <th>Unit Price</th>
                                    </tr>

                                    @{
                                        var totalBill = 0;
                                    }

                                    @foreach (var order in item.InvoiceItems)
                                    {
                                        <tr>
                                            <td>@order.Description</td>
                                            <td>@order.Quantity</td>
                                            <td>@order.UnitPrice</td>
                                        </tr>
                                        totalBill = totalBill + Convert.ToInt32(order.TotalAmount);
                                    }
                                </tbody>
                            </table>
                            <span class="float-end" style="margin-right:100px;"><strong>Invoice Total Price:  </strong> @totalBill</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="newOrderModal">

    <div class="modal-dialog modal-lg" style=" width: 900px !important;">

        <div class="modal-content">

            <div class="modal-header">

                <h4>Add New Invoice</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

            </div>

            <form id="NewOrderForm">

                <div class="modal-body">

                    @*Invoice Details*@

                    <h5 style="color:#ff6347">Invoice Details</h5>

                    <hr />

                    <div class="row align-items-center mb-3">

                        <input type="hidden" id="InvoiceId" />

                        <label class="col-form-label col-md-3">Serial No</label>

                        <div class="col-md-3">
                            <input type="text" id="InvoiceSerialNumber" name="InvoiceSerialNumber" placeholder="Invoice Serial No" class="form-control" />
                        </div>

                        <label class="col-form-label col-md-2">Sequence No</label>

                        <div class="col-md-4">
                            <input type="text" id="InvoiceSequenceNumber" name="InvoiceSequenceNumber" placeholder="Invoice Sequence Number" class="form-control" />
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">

                        <label class="col-form-label col-md-3">Date</label>

                        <div class="col-md-3">
                            <input type="text" id="Date" name="Date" placeholder="Date" class="form-control" />
                        </div>

                        <label class="col-form-label col-md-2">Tax Office</label>

                        <div class="col-md-4">
                            <input type="text" id="TaxOffice" name="TaxOffice" placeholder="Tax Office" class="form-control" />
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">

                        <label class="col-form-label col-md-3">Time</label>

                        <div class="col-md-3">
                            <input type="text" id="Time" name="Time" placeholder="Time" class="form-control" />
                        </div>

                        <label class="col-form-label col-md-2">Delivered By</label>

                        <div class="col-md-4">
                            <input type="text" id="DeliveredBy" name="DeliveredBy" placeholder="DeliveredBy Staff" class="form-control" />
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">

                        <label class="col-form-label col-md-3">Received By</label>

                        <div class="col-md-3">
                            <input type="text" id="ReceivedBy" name="ReceivedBy" placeholder="Received By" class="form-control" />
                        </div>

                        @*<label class="col-form-label col-md-2">Total</label>

                        <div class="col-md-4">
                            <input type="text" id="Total" name="Total" placeholder="Total Price" class="form-control" />
                        </div>*@
                    </div>

                    @*Invoice Items*@
                    <h5 style="color:#ff6347">Invoice Items</h5>
                    <hr />
                    <input type="hidden" id="id" />

                    <div class="row align-items-center mb-3">
                        <label class="col-form-label col-md-3">Product Name</label>
                        <div class="col-md-3">
                            <input type="text" id="Description" name="Description" placeholder="Description" class="form-control" />
                        </div>
                        <label class="col-form-label col-md-2">Quantity</label>
                        <div class="col-md-4">
                            <input type="number" id="Quantity" name="Quantity" placeholder="Quantity" class="form-control" />
                        </div>
                    </div>

                    <div class="row align-items-center mb-3">
                        <label class="col-form-label col-md-3">Unit Price</label>
                        <div class="col-md-3">
                            <input type="number" id="UnitPrice" name="UnitPrice" placeholder="UnitPrice" class="form-control" />
                        </div>
                        <div class="col-md-2 offset-lg-4">
                            <a id="addToList" class="btn btn-primary" role="button">Add To List</a>
                        </div>
                    </div>



                    <table id="detailsTable" class="table mt-3">

                        <thead>

                            <tr>

                                <th style="width:30%">Description</th>
                                
                                <th style="width:20%">Quantity</th>

                                <th style="width:15%">Unit Price</th>

                                <th style="width:25%">Total Amount</th>

                            </tr>

                        </thead>

                        <tbody></tbody>

                    </table>

                </div>
        
                <div class="modal-footer">

                    <button type="reset" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

                    <button id="saveOrder" type="submit" class="btn btn-danger">Save Invoice</button>

                </div>

            </form>

        </div>

    </div>

</div>

@section scripts{

    <script>

        //Show Modal.

        function addNewOrder() {

            var modal = new bootstrap.Modal(document.getElementById('newOrderModal'));
            modal.show();

        }

        //Add Multiple Order.

        $("#addToList").click(function (e) {

            e.preventDefault();



            if ($.trim($("#Description").val()) == "" || $.trim($("#UnitPrice").val()) == "" || $.trim($("#Quantity").val()) == "") return;



            var Description = $("#Description").val(),

                UnitPrice = $("#UnitPrice").val(),

                Quantity = $("#Quantity").val(),

                detailsTableBody = $("#detailsTable tbody");



            var InvoiceItem = '<tr><td>' + Description + '</td><td>' + Quantity + '</td><td>' + UnitPrice + '</td><td>' + (parseFloat(UnitPrice) * parseInt(Quantity)) + '</td><td><a data-itemId="0" href="#" class="deleteItem">Remove</a></td></tr>';

            detailsTableBody.append(InvoiceItem);

            clearItem();

        });

        //After Add A New Order In The List, Clear Clean The Form For Add More Order.

        function clearItem() {

            $("#Description").val('');

            $("#UnitPrice").val('');

            $("#Quantity").val('');

        }

        // After Add A New Order In The List, If You Want, You Can Remove It.

        $(document).on('click', 'a.deleteItem', function (e) {

            e.preventDefault();

            var $self = $(this);

            if ($(this).attr('data-itemId') == "0") {

                $(this).parents('tr').css("background-color", "#ff6347").fadeOut(800, function () {

                    $(this).remove();

                });

            }

        });

        //After Click Save Button Pass All Data View To Controller For Save Database

        function saveOrder(data) {

            return $.ajax({

                contentType: 'application/json; charset=utf-8',

                dataType: 'json',

                type: 'POST',

                url: "/Invoices/SaveInvoice",

                data: data,

                success: function (result) {

                    alert(result);

                    location.reload();

                },

                error: function () {

                    alert("Error!")

                }

            });

        }

        //Collect Multiple Order List For Pass To Controller

        $("#saveOrder").click(function (e) {

            e.preventDefault();



            var orderArr = [];

            orderArr.length = 0;



            $.each($("#detailsTable tbody tr"), function () {

                orderArr.push({

                    Description: $(this).find('td:eq(0)').html(),

                    Quantity: $(this).find('td:eq(1)').html(),

                    UnitPrice: $(this).find('td:eq(2)').html(),

                    TotalAmount: $(this).find('td:eq(3)').html()

                });

            });





            var data = JSON.stringify({

                InvoiceSerialNumber: $("#InvoiceSerialNumber").val(),
                InvoiceSequenceNumber: $("#InvoiceSequenceNumber").val(),
                Date: $("#Date").val(),
                TaxOffice: $("#TaxOffice").val(),
                Time: $("#Time").val(),
                DeliveredBy: $("#DeliveredBy").val(),
                ReceivedBy: $("#ReceivedBy").val(),
                Total: $("#Total").val(),

                items: orderArr

            });



            $.when(saveOrder(data)).then(function (response) {

                console.log(response);

            }).fail(function (err) {

                console.log(err);

            });

        });

    </script>

}