@model MvcOnlineTicariOtomasyon.Models.Class.Customer
@{
    ViewBag.Title = "Update Customer";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Update Customer Information</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("UpdateCustomer", "Customers", FormMethod.Post))
            {
                @Html.HiddenFor(x => x.CustomerID)

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(x => x.CustomerName, "First Name")
                        @Html.TextBoxFor(x => x.CustomerName, new { @class = "form-control", placeholder = "Enter name..." })
                        @Html.ValidationMessageFor(x => x.CustomerName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(x => x.CustomerSurname, "Last Name")
                        @Html.TextBoxFor(x => x.CustomerSurname, new { @class = "form-control", placeholder = "Enter surname..." })
                        @Html.ValidationMessageFor(x => x.CustomerSurname, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(x => x.CustomerEmail, "Email Address")
                        @Html.TextBoxFor(x => x.CustomerEmail, new { @class = "form-control", type = "email", placeholder = "example@mail.com" })
                        @Html.ValidationMessageFor(x => x.CustomerEmail, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(x => x.CustomerCity, "City")
                        @Html.TextBoxFor(x => x.CustomerCity, new { @class = "form-control", placeholder = "Enter city..." })
                        @Html.ValidationMessageFor(x => x.CustomerCity, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a href="/Customers/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            }
        </div>
    </div>
</div>