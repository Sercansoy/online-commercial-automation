@model MvcOnlineTicariOtomasyon.Models.Class.SaleTransaction
@{
    ViewBag.Title = "MakeSale";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container mt-4 mb-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0" style="border-radius: 10px; overflow: hidden;">

                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0 font-weight-bold" style="letter-spacing: 0.5px;">Make A Sale</h4>
                </div>

                <div class="card-body px-5 py-4">
                    @using (Html.BeginForm("NewSale", "Sales", FormMethod.Post))
                    {
                        <div class="form-group mb-3">
                            <label class="small font-weight-bold text-dark">Product</label>
                            <input type="text" name="Productid" value="@ViewBag.id" class="form-control" readonly/>
                            @*@Html.TextBoxFor(x => x.Productid, new { @class = "form-control custom-input-sm" })*@
                        </div>

                        <div class="form-group mb-3">
                            <label class="small font-weight-bold text-dark">Customer</label>
                            @Html.TextBoxFor(x => x.Customerid, new { @class = "form-control custom-input-sm" })
                        </div>

                        <div class="form-group mb-3">
                            <label class="small font-weight-bold text-dark">Staff</label>
                            @Html.DropDownListFor(x => x.Staffid, (List<SelectListItem>)
                           ViewBag.ValueStaff, "Select Staff", new { @class = "form-control custom-input-sm" })
                        </div>

                        <div class="form-group mb-3">
                            <label class="small font-weight-bold text-dark">Quantity</label>
                            <input id="nbr1" name="Quantity" type="number" class="form-control" max="20" min="0" onchange="sum();" />
                            @*@Html.TextBoxFor(x => x.Quantity, new { @class = "form-control custom-input-sm" })*@
                        </div>

                        <div class="form-group mb-3">
                            <label class="small font-weight-bold text-dark">Price</label>
                            <input id="nbr2" type="text" name="Price" value="@ViewBag.Price" class="form-control" onkeyup="sum();" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="small font-weight-bold text-dark">Total Amount</label>
                            <input id="nbr3" name="TotalAmount" type="number" class="form-control" readonly  value="0"/>
                            @*@Html.TextBoxFor(x => x.TotalAmount, new { @class = "form-control custom-input-sm" })*@
                        </div>

                        <div class="text-center mt-2">
                            <button class="btn btn-info text-white px-4 py-2 shadow-sm hover-button" style="border-radius: 6px; font-weight: 600; width: 100%; background-color: #0dcaf0; border:none;">
                                <i class="fas fa-plus-circle mr-2"></i> Create Sale
                            </button>
                            <a href="/Products/Index" class="text-muted small font-weight-bold text-decoration-none">
                                <i class="fas fa-arrow-left mr-1"></i> Back to Sales List
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function sum() {
        var number1 = document.getElementById('nbr1').value
        var number2 = document.getElementById('nbr2').value
        var sonuc = parseInt(number1) * parseInt(number2);
        if (!isNaN(sonuc)) {
            document.getElementById('nbr3').value = sonuc;
        }
    }
</script>

<style>
    /* Daha ince ve kompakt inputlar */
    .custom-input-sm {
        border: 1px solid #d1d1d1;
        border-radius: 6px;
        padding: 8px 12px;
        height: auto;
        font-size: 0.9rem;
        background-color: #f9f9f9;
        transition: all 0.2s ease;
    }

        .custom-input-sm:focus {
            border-color: #007bff;
            background-color: #fff;
            box-shadow: 0 0 5px rgba(0,123,255,0.1);
            outline: none;
        }

    /* Başlıkların puntosunu küçülttük ama kalın */
    label.small {
        font-size: 0.85rem;
        margin-bottom: 5px;
    }

    .hover-button:hover {
        opacity: 0.9;
        transform: scale(1.01);
        transition: 0.2s;
    }
</style>
