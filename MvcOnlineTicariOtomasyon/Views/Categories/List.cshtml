@model MvcOnlineTicariOtomasyon.Models.Class.List

@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script>
    $(function () {
        $('#DrpCategory').change(function () {
            var id = $('#DrpCategory').val();
            $.ajax({
                url: '/Categories/ProductList/',
                data: { p: id },
                type: "POST",
                dataType: "Json",
                success: function (data) {
                    console.log(data);
                    $('#DrpProduct').empty();
                    for (var i = 0; i < data.length; i++) {
                        $('#DrpProduct').append("<option value ='" + data[i].Value + "'>" +
                            data[i].Text + "</Option>");
                  }
                }
            });
        });
    });
</script>


<br />

<div> <h2> Category - Product</h2></div>
<br />

<div>
    @Html.Label("Categorys")
    @Html.DropDownList("DrpCategory", Model.Categorys, "-- Select Category --", new { @class = "form-control" })
</div>
<br />
<div>
    @Html.Label("Products")
    @Html.DropDownList("DrpProduct", Model.Products, "-- Select Product --", new { @class = "form-control" })
</div>

