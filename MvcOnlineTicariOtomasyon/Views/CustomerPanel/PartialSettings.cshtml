@model MvcOnlineTicariOtomasyon.Models.Class.Customer

@using (Html.BeginForm("Settings", "CustomerPanel", FormMethod.Post))
{

    <form class="form-horizontal">
        @Html.HiddenFor(x => x.CustomerID)
        <div class="form-group row">

            <label name="CustomerName" class="col-sm-2 col-form-label">Name</label>

            <div class="col-sm-10">

                @Html.TextBoxFor(x => x.CustomerName, new { @class = "form-control", @readonly = "readonly" })

            </div>

        </div>

        <div class="form-group row">

            <label class="col-sm-2 col-form-label">Surname</label>

            <div class="col-sm-10">

                @Html.TextBoxFor(x => x.CustomerSurname, new { @class = "form-control", @readonly = "readonly" })

            </div>

        </div>

        <div class="form-group row">

            <label for="inputName2" class="col-sm-2 col-form-label">Email</label>

            <div class="col-sm-10">

                @Html.TextBoxFor(x => x.CustomerEmail, new { @class = "form-control", @readonly = "readonly" })

            </div>

        </div>

        <div class="form-group row">
            <label class="col-sm-2 col-form-label">City</label>
            <div class="col-sm-10">

                @Html.TextBoxFor(x => x.CustomerCity, new { @class = "form-control" })

            </div>

        </div>

        @*<div class="form-group row">

                <label class="col-sm-2 col-form-label">Password</label>

                <div class="col-sm-10">

                    @Html.TextBoxFor(x => x.CustomerPassword, new { @class = "form-control" })

                </div>

            </div>*@
        <div class="form-group row">
            <label class="col-sm-2 col-form-label">Password</label>
            <div class="col-sm-10">
                <div class="input-group">
                    @Html.TextBoxFor(x => x.CustomerPassword, new { @class = "form-control", type = "password", id = "customerPasswordInput" })
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn" tabindex="-1">
                            <i class="fa fa-eye-slash" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group row">

            <div class="offset-sm-2 col-sm-10">

                <button type="submit" class="btn btn-danger">Update</button>

            </div>

        </div>

    </form>
}

<script>
    document.getElementById("togglePasswordBtn").addEventListener("click", function () {
        var passwordInput = document.getElementById("customerPasswordInput");
        var icon = document.getElementById("togglePasswordIcon");

        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        } else {
            passwordInput.type = "password";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        }
    });
</script>
