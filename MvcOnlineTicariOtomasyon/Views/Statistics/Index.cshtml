@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="~/web2/css/style.css" rel="stylesheet" type="text/css" media="all" />
    <script src="~/web2/js/jquery.min.js"></script>
    <link rel="stylesheet" href="~/web2/css/font-awesome.css">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="keywords" content="Metro Panel Responsive web template, Bootstrap Web Templates, Flat Web Templates, Andriod Compatible web template,
Smartphone Compatible web template, free webdesigns for Nokia, Samsung, LG, SonyErricsson, Motorola web design" />
    <script type="application/x-javascript"> addEventListener("load", function() { setTimeout(hideURLbar, 0); }, false); function hideURLbar(){ window.scrollTo(0,1); } </script>
    <link href='http://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800' rel='stylesheet' type='text/css'>
    <script src="js/zingchart.min.js"></script>
    <script src="js/zingchart.jquery.js"></script>
    <script src="js/jquery.easydropdown.js"></script>
    <script src="js/jquery.nicescroll.js"></script>
    <link href="css/jqvmap.css" media="screen" rel="stylesheet" type="text/css" />
    <script src="~/web2/js/easyResponsiveTabs.js" type="text/javascript"></script>
    <link href="~/web2/css/nav.css" rel="stylesheet" type="text/css" media="all" />
    <script src="~/web2/js/main.js"></script>
    <script src="~/web2/js/Chart1.js"></script>
    <style>
        .icon-text h3 {
            font-size: clamp(13px, 2.5vw, 24px);
            word-break: break-word;
            overflow-wrap: break-word;
            white-space: normal;
            line-height: 1.2;
            margin-bottom: 4px;
        }

        .sales, .new-users, .orders, .visitors {
            min-height: 90px;
            display: flex;
            align-items: center;
            padding: 16px;
            box-sizing: border-box;
        }

        .sales, .new-users, .orders, .visitors {
            min-height: 100px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 16px;
            border-radius: 10px;
            box-sizing: border-box;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

            .sales:hover, .new-users:hover, .orders:hover, .visitors:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.2);
            }

        .icon-text h3 {
            font-size: clamp(14px, 2.5vw, 26px);
            font-weight: 700;
            color: white;
            margin: 0 0 6px 0;
            word-break: break-word;
            line-height: 1.2;
        }

        .icon-text p {
            font-size: 13px;
            color: rgba(255,255,255,0.85);
            margin: 0;
            font-weight: 400;
            letter-spacing: 0.3px;
        }

        .list_of_members {
            gap: 12px;
            display: flex;
        }

        .total-content {
            margin-bottom: 12px;
        }
    </style>
</head>
<body>

    <div class="total-content">
        <div class="list_of_members">
            <div class="sales" style="background-color:#1abc9c">
                <div class="icon-text">
                    <h3>@ViewBag.Customer</h3>
                    <p>Total Customers</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="new-users" style="background-color:#2ecc71">
                <div class="icon-text">
                    <h3>@ViewBag.Product</h3>
                    <p>Total Products</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="orders" style="background-color:#3498db">
                <div class="icon-text">
                    <h3>@ViewBag.Staff</h3>
                    <p>Total Staff</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="visitors" style="background-color:#9b59b6">
                <div class="icon-text">
                    <h3>@ViewBag.Categorie</h3>
                    <p>Total Categories</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
    <div class="clearfix"></div>

    <div class="total-content">
        <div class="list_of_members">
            <div class="sales" style="background-color:#16a085">
                <div class="icon-text">
                    <h3>@ViewBag.Stock</h3>
                    <p>Total Stock</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="new-users" style="background-color:#27ae60">
                <div class="icon-text">
                    <h3>@ViewBag.Brand</h3>
                    <p>Total Brands</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="orders" style="background-color:#2980b9">
                <div class="icon-text">
                    <h3>@ViewBag.StockAlert</h3>
                    <p>Critical Stock Alert</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="visitors" style="background-color:#8e44ad">
                <div class="icon-text">
                    <h3>@ViewBag.HighestProduct</h3>
                    <p>Highest Priced Product</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
    <div class="clearfix"></div>

    <div class="total-content">
        <div class="list_of_members">
            <div class="sales" style="background-color:#f1c40f">
                <div class="icon-text">
                    <h3>@ViewBag.LowestProduct</h3>
                    <p>Lowest Priced Product</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="new-users" style="background-color:#e67e22">
                <div class="icon-text">
                    <h3>@ViewBag.TopBrand</h3>
                    <p>Top Brand</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="orders" style="background-color:#e74c3c">
                <div class="icon-text">
                    <h3>@ViewBag.Refrigerator</h3>
                    <p>Refrigerator Count</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="visitors" style="background-color:#95a5a6">
                <div class="icon-text">
                    <h3>@ViewBag.Laptop</h3>
                    <p>Laptop Count</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
    <div class="clearfix"></div>

    <div class="total-content">
        <div class="list_of_members">
            <div class="sales" style="background-color:#f39c12">
                <div class="icon-text">
                    <h3>@ViewBag.BestSeller</h3>
                    <p>Best Seller</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="new-users" style="background-color:#d35400">
                <div class="icon-text">
                    <h3>@ViewBag.Revenue</h3>
                    <p>Total Revenue</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="orders" style="background-color:#c0392b">
                <div class="icon-text">
                    <h3>@ViewBag.TodaySale</h3>
                    <p>Today's Sales</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="visitors" style="background-color:#7f8c8d">
                <div class="icon-text">
                    <h3>@ViewBag.TodayRevenue</h3>
                    <p>Today's Revenue</p>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
        <div class="clearfix"></div>
    </div>
</body>
</html>
