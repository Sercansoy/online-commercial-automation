@model MvcOnlineTicariOtomasyon.Models.Class.Staff
@{
    ViewBag.Title = "AddStaff";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<div class="container-fluid pt-4 px-4">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-11 col-12">

            <div class="d-flex align-items-center justify-content-between mb-4">
                <h4 class="mb-0 text-dark font-weight-bold">New Staff Registration</h4>
                <a href="/Staffs/Index" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="fas fa-arrow-left fa-sm mr-1"></i> Back to List
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-5">

                    @using (Html.BeginForm("AddStaff", "Staffs", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group mb-4">
                            <label class="form-label text-muted font-weight-bold small">STAFF NAME</label>
                            @Html.TextBoxFor(x => x.StaffName, new { @class = "form-control custom-form-input", placeholder = "Enter staff name" })
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label text-muted font-weight-bold small">SURNAME</label>
                            @Html.TextBoxFor(x => x.StaffSurname, new { @class = "form-control custom-form-input", placeholder = "Enter staff surname" })
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label text-muted font-weight-bold small">DEPARTMENT</label>
                            @Html.DropDownListFor(x => x.Departmentid, (List<SelectListItem>)ViewBag.DepartmentList, "Select Department...", new { @class = "form-control custom-form-input form-select" })
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label text-muted font-weight-bold small">UPLOAD STAFF IMAGE (OPTION 1)</label>
                            <input type="file" name="ImageFile" class="form-control custom-form-input" accept="image/*" />
                        </div>

                        <div class="text-center my-3 text-muted font-weight-bold small">- OR -</div>

                        <div class="form-group mb-4">
                            <label class="form-label text-muted font-weight-bold small">STAFF IMAGE URL</label>
                            @Html.TextBoxFor(x => x.StaffImage, new { @class = "form-control custom-form-input", placeholder = "Paste image URL path" })
                        </div>

                        <hr class="my-4 opacity-50">

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-5 py-2-5 font-weight-bold shadow-sm" style="font-size: 0.95rem; border-radius: 4px;">
                                <i class="fas fa-save mr-2"></i> Save Staff Profile
                            </button>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>

<style>

    .custom-form-input {
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 12px 16px; 
        font-size: 0.95rem;
        height: auto;
        background-color: #fff;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .custom-form-input:focus {
            border-color: #80bdff;
            outline: 0;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            background-color: #fff;
        }

    .form-label {
        letter-spacing: 0.8px;
        margin-bottom: 8px;
        display: block;
    }

    .py-2-5 {
        padding-top: 10px;
        padding-bottom: 10px;
    }
</style>